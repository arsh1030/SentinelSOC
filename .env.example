# SentinelSOC configuration
# Copy to .env  -  never commit the real file.

# ---- Provider chain ---------------------------------------------------------
# OpenRouter is primary. Gemini is the runtime fallback: if an OpenRouter call
# fails - network, 401, 429, bad slug, unparseable output - the same call is
# retried against Gemini before anything gives up.
#
# With neither key set, the platform runs on its deterministic fallbacks. Every
# stage still completes and the demo still works; agent output is templated
# rather than reasoned.

OPENROUTER_API_KEY=your_openrouter_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# ---- Model selection --------------------------------------------------------
# Verify a slug before relying on it:   python scripts/check_providers.py
#
# Default is a FREE model - no credit card needed. See the free options with:
#     python scripts/check_providers.py --free
# OPENROUTER_MODEL=z-ai/glm-5.2:free
#
# Free tiers are rate-limited (commonly ~20 req/min plus a daily cap). One full
# pipeline run is ~17 calls, so record a cached run early and demo from it.
# Paid slugs work by just setting this - anthropic/*, openai/*, google/*.
#
# Gemini keys: aistudio.google.com/apikey
# GEMINI_MODEL=gemini-2.5-flash

# Optional attribution shown on OpenRouter's dashboards.
# OPENROUTER_REFERER=https://your-repo-url
# OPENROUTER_TITLE=SentinelSOC

# ---- Redaction --------------------------------------------------------------
# What the third-party API is allowed to see.
#   off     send everything as-is
#   pii     personal data pseudonymised, credentials destroyed   [default]
#   strict  also pseudonymise IPs, hostnames and account names
# Tokens are consistent per session and reversed before you see them.
# REDACT_MODE=pii

# ---- Demo safety ------------------------------------------------------------
# RECORD_DEMO=1        capture every model response to fixtures/demo_run.json
# DEMO_MODE=cached     replay that file; makes zero network calls

# ---- Graph store (FalkorDB) -------------------------------------------------
# Unset: an embedded FalkorDB (falkordblite) runs from data/sentinel.falkordb,
# no server or Docker needed. Set to use a FalkorDB server instead, e.g.
#   docker run -p 6379:6379 -it --rm falkordb/falkordb
# FALKORDB_URL=redis://localhost:6379
# FALKORDB_GRAPH=sentinel
